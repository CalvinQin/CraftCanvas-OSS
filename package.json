{
  "name": "craftcanvas",
  "private": true,
  "version": "0.7.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs && node scripts/build-worker.mjs",
    "preview": "vite preview",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply craftcanvas-local --local",
    "dev:api": "wrangler dev --port 8787",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "verify:seo": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@noble/hashes": "^2.4.0",
    "ag-psd": "^31.0.2",
    "drizzle-orm": "^0.45.3",
    "imagetracerjs": "^1.2.6",
    "jspdf": "^4.2.1",
    "jszip": "3.10.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.147.0"
  },
  "license": "MIT",
  "description": "Open-source AI product imagery workspace with an infinite canvas and visual node workflows.",
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
