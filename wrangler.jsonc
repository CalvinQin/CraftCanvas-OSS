{
  "name": "craftcanvas-local",
  "main": "server/worker.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "craftcanvas-local",
      "database_id": "local",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "craftcanvas-local"
    }
  ]
}
